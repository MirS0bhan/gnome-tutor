<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gnome-tutor">
	<schema id="ir.urumlug.gnomeTutor" path="/ir/urumlug/gnomeTutor/">
		<key name="content-pack-id" type="s">
			<default>'core'</default>
			<summary>Active content pack</summary>
		</key>
		<key name="first-run-complete" type="b">
			<default>false</default>
			<summary>Whether the first-run welcome dialog has been shown</summary>
		</key>
		<key name="completed-steps" type="as">
			<default>[]</default>
			<summary>Completed lesson step IDs</summary>
		</key>
		<key name="completed-modules" type="as">
			<default>[]</default>
			<summary>Completed module IDs</summary>
		</key>
		<key name="hint-counts-json" type="s">
			<default>''</default>
			<summary>JSON map of hint reveal counts per step</summary>
		</key>
	</schema>
</schemalist>

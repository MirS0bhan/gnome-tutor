<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ir.urumlug.gnomeTutor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>GNOME Linux Academy</name>
  <summary>Learn Linux with real GNOME apps and the terminal</summary>
  <description>
    <p>
      GNOME Linux Academy teaches Linux through four-beat modules: contrast the Windows
      habit, practice in real GNOME apps, run commands in a sandboxed terminal, and
      connect the two approaches.
    </p>
    <p>
      Tracks cover the filesystem, desktop orientation, permissions, software installation,
      and processes. An optional Shell extension highlights windows while you follow along.
    </p>
  </description>

  <developer id="ir.urumlug">
    <name>UrumLUG</name>
  </developer>

  <url type="homepage">https://github.com/mirs0bhan/gnome-tutor</url>
  <url type="vcs-browser">https://github.com/mirs0bhan/gnome-tutor</url>
  <url type="bugtracker">https://github.com/mirs0bhan/gnome-tutor/issues</url>
  <url type="contribute">https://github.com/mirs0bhan/gnome-tutor/blob/main/docs/authoring.md</url>

  <translation type="gettext">gnome-tutor</translation>
  <launchable type="desktop-id">ir.urumlug.gnomeTutor.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#1c71d8</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <caption>Curriculum sidebar with Files track modules</caption>
      <image>https://raw.githubusercontent.com/mirs0bhan/gnome-tutor/main/data/screenshots/curriculum.png</image>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.0" date="2026-08-14">
      <description>
        <p>Initial release with core curriculum tracks 0–4, practice sandbox, and optional spotlight extension.</p>
      </description>
    </release>
  </releases>

</component>

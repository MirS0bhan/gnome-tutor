<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ir.urumlug.gnomeTutor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Linux Academy</name>
  <summary>Learn Linux through real GUI apps and a real terminal</summary>
  <description>
    <p>
      Linux Academy teaches newcomers how to use Linux by showing every concept twice:
      once in a real GUI app and once in a real terminal, with an explicit bridge between the two.
    </p>
    <p>
      Lessons use safe practice sandboxes, tiered hints, and an optional GNOME Shell spotlight
      extension for on-screen guidance during GUI exercises.
    </p>
  </description>

  <developer id="ir.urumlug">
    <name>misano / UrumLUG</name>
  </developer>

  <url type="homepage">https://github.com/MirS0bhan/gnome-tutor</url>
  <url type="vcs-browser">https://github.com/MirS0bhan/gnome-tutor</url>
  <url type="bugtracker">https://github.com/MirS0bhan/gnome-tutor/issues</url>

  <translation type="gettext">gnome-tutor</translation>
  <launchable type="desktop-id">ir.urumlug.gnomeTutor.desktop</launchable>

  <content_rating type="oars-1.1">
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>

  <branding>
    <color type="primary" scheme_preference="light">#3584e4</color>
    <color type="primary" scheme_preference="dark">#3584e4</color>
  </branding>

  <releases>
    <release version="0.1.0" date="2026-08-14">
      <description>
        <p>Initial preview with curriculum tracks 0–9, VTE sandbox lessons, and optional Spotlight extension.</p>
      </description>
    </release>
  </releases>
</component>

{
  "root": true,
  "env": {
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended"],
  "globals": {
    "_": "readonly",
    "C_": "readonly",
    "N_": "readonly",
    "pkg": "readonly",
    "console": "readonly",
    "TextDecoder": "readonly",
    "TextEncoder": "readonly"
  },
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["tools/**/*.js"],
      "globals": {
        "print": "readonly",
        "printerr": "readonly"
      }
    },
    {
      "files": ["extension/**/*.js"],
      "globals": {
        "global": "readonly"
      }
    }
  ]
}

{
    "id": "ir.urumlug.gnomeTutor",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "ir.urumlug.gnomeTutor",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=home",
        "--talk-name=org.freedesktop.FileManager1",
        "--talk-name=systems.misano.LinuxAcademy.Spotlight"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "gnome-tutor",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [
                "-Dprefix=/app"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/mirs0bhan/gnome-tutor.git",
                    "branch": "main"
                }
            ]
        }
    ]
}

{
    "id" : "ir.urumlug.gnomeTutor",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "ir.urumlug.gnomeTutor",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=home",
        "--talk-name=org.freedesktop.FileManager1",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.portal.Desktop",
        "--talk-name=org.freedesktop.portal.OpenURI",
        "--talk-name=systems.misano.LinuxAcademy.Spotlight"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        {
            "name" : "bubblewrap",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dtests=false",
                "-Dzidmap=false"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://github.com/containers/bubblewrap.git",
                    "tag" : "v0.10.0"
                }
            ]
        },
        {
            "name" : "vte",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dgtk3=false",
                "-Dgtk4=true",
                "-Ddocs=false",
                "-Da11y=true",
                "-Dvapi=false",
                "--libdir=lib"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/vte.git",
                    "tag" : "0.78.2"
                }
            ]
        },
        {
            "name" : "gnome-tutor",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "dir",
                    "path" : "."
                }
            ]
        }
    ]
}
